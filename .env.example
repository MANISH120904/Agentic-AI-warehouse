# Copy to .env and fill in values. Never commit .env.
# Rotate any key that was pasted into chat or shared.

# --- App ---
APP_ENV=development
MOCK_MODE=true
PUBLIC_BASE_URL=
API_HOST=127.0.0.1
API_PORT=8765
HTTP_TIMEOUT_SECONDS=30

# --- Edesy Hosted Voice Agent API (voice-agent.edesy.in) ---
# Create keys in Edesy dashboard → Settings → API Keys
# Required scopes for MVP: agents:read, calls:read, calls:write
# Optional: agents:write, functions:read, functions:write, phone_numbers:read
EDESY_API_KEY=
EDESY_API_BASE_URL=https://voice-agent.edesy.in/api/v1
EDESY_AGENT_ID=
# Optional caller ID (must be a number configured in your Edesy workspace)
EDESY_FROM_NUMBER=
# Optional: phone shown in settings / docs only (not required for hosted Calls API)
EDESY_PHONE_NUMBER=

# SIP trunk product credentials (voice-api.edesy.in) — NOT used by this MVP
# EDESY_ACCOUNT_SID=
# EDESY_APPLICATION_SID=

# --- Google / ADK (browser voice agent) ---
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
# Live-capable model id; verify against current Gemini Live docs
ADK_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
